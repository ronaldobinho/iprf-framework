# IPRF — local development environment
#
# Copy to .env and adjust. .env is git-ignored and must never be committed.
# These values are for LOCAL DEVELOPMENT with SYNTHETIC DATA ONLY.
# Production credentials are supplied by the deployment environment, never here.
#
# The *_PORT values below are HOST-side ports only; container-internal ports are
# fixed. If you already run another Postgres/Redis/RabbitMQ locally, change these
# rather than stopping the other stack — nothing in IPRF depends on the defaults.

# --- PostgreSQL 16 --------------------------------------------------------
POSTGRES_DB=iprf
POSTGRES_USER=iprf
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Redis 7 --------------------------------------------------------------
# Holds pre-computed risk state read in-path. Never queried synchronously
# against the primary database during authorization.
REDIS_PORT=6379

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_USER=iprf
RABBITMQ_PASSWORD=change-me-locally
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Backend --------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
